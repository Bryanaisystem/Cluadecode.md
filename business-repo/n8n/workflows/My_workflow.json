      "id": "078b1eab-2ece-47c0-b66b-b028d111c32d",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Get Gemini text output\nconst rawText = $input.first().json?.candidates?.[0]?.content?.parts?.[0]?.text ?? '';\n\n// Remove ```json and ``` if they exist\nconst cleaned = String(rawText)\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\n// Parse JSON\nlet parsed;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  return [\n    {\n      json: {\n        title: null,\n        category: null,\n        source_confidence: null\n      }\n    }\n  ];\n}\n\n// Return only the variables you want\nreturn [\n  {\n    json: {\n      title: parsed.title ?? null,\n      category: parsed.category ?? null,\n      source_confidence: parsed.source_confidence ?? null\n    }\n  }\n];"
      },
